#!/usr/bin/env bash
set -euo pipefail
# bin/compile <build-dir> <cache-dir> <env-dir>

header() {
  echo ""
  echo "-----> $*"
}

export_env_dir() {
  local env_dir="$1"
  local acceptlist_regex="${2:-''}"
  local denylist_regex="${3:-'^(PATH|GIT_DIR|CPATH|CPPATH|LD_PRELOAD|LIBRARY_PATH)$'}"
  if [ -d "$env_dir" ]; then
    while IFS= read -r -d '' e; do
      if [ -z "$acceptlist_regex" ] || echo "$e" | grep -E "$acceptlist_regex" | grep -qvE "$denylist_regex"; then
        export "$e=$(cat "$env_dir/$e")"
      fi
    done < <(find "$env_dir" -maxdepth 1 -type f -print0)
  fi
}

output() {
  while IFS= read -r LINE; do
    # do not indent headers that are being piped through the output
    if [[ "$LINE" =~ ^-----\>.* ]]; then
      echo "$LINE"
    else
      echo "       $LINE"
    fi
  done
}

echo "WARNING: THIS BUILDPACK IS NO LONGER MAINTAINED"
echo "WARNING: USE OF OFFICIAL HEROKU BUILDPACK RECOMMENDED INSTEAD"
echo "" | output
echo "This buildpack is no longer maintained." | output
echo "You may use the following buildpack to install 'ffmpeg' in your app:" | output
echo "https://github.com/heroku/heroku-buildpack-activestorage-preview" | output
echo "" | output

header "Installing ffmpeg"

BUILD_DIR="${1:?Build directory not provided}"
ENV_DIR="${3:-}"
VENDOR_DIR="vendor"
FFMPEG_ARCHIVE_NAME="ffmpeg.tar.xz"

if [ -n "$ENV_DIR" ]; then
  export_env_dir "$ENV_DIR"
fi

cd "$BUILD_DIR"
mkdir -p "$VENDOR_DIR"
cd "$VENDOR_DIR"
mkdir -p ffmpeg
cd ffmpeg

if [ -z "${FFMPEG_DOWNLOAD_URL:-}" ]; then
  echo "Variable FFMPEG_DOWNLOAD_URL isn't set, using default value" | output
  FFMPEG_DOWNLOAD_URL="https://johnvansickle.com/ffmpeg/builds/ffmpeg-git-amd64-static.tar.xz"
fi

echo "Downloading $FFMPEG_DOWNLOAD_URL" | output

code=$(curl "$FFMPEG_DOWNLOAD_URL" -L --silent --fail --retry 5 --retry-max-time 15 -o "./$FFMPEG_ARCHIVE_NAME" --write-out "%{http_code}")

if [ "$code" != "200" ]; then
  echo "Unable to download ffmpeg: $code" | output
  exit 1
fi

echo "Unpacking the archive" | output

if ! tar xJf "./$FFMPEG_ARCHIVE_NAME" --strip-components=1; then
  echo "Failed to unpack" | output
  exit 1
fi

rm -f "$FFMPEG_ARCHIVE_NAME"

PROFILE_PATH="$BUILD_DIR/.profile.d/ffmpeg.sh"
mkdir -p "$(dirname "$PROFILE_PATH")"
echo 'export PATH="$PATH:${HOME}/vendor/ffmpeg"' >> "$PROFILE_PATH"

echo "Installation successful" | output
